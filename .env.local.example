# SQL Server en el VPS (debe ser accesible desde internet para Vercel)
DB_SERVER=tu-vps.ejemplo.com
DB_PORT=1433
DB_NAME=whatsapp_costos
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Secreto único (firma sesiones y cifra tokens de Meta). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=
# Mismo valor que APP_SECRET. Vercel exige este nombre para autenticar el cron.
CRON_SECRET=

GRAPH_API_VERSION=v25.0
